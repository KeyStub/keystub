# ---- Required ----
# Random 32+ byte secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database ----
# Leave empty to use the embedded local database in ./.data (dev only).
# Production: a Postgres URL, e.g. from Neon (free tier) — postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# ---- Email (password reset / verification) ----
# Leave empty to print emails to the console + .data/outbox.log
RESEND_API_KEY=
EMAIL_FROM="Santa Fe Tracker <noreply@yourdomain.com>"

# ---- Billing (optional until you charge) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ---- Misc ----
# Comma-separated emails that always get Pro (founder/testing accounts)
FOUNDER_EMAILS=
# Secret for the reminder-email cron endpoint (/api/cron/reminders)
CRON_SECRET=
